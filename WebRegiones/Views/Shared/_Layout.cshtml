<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] - Regiones de Chile</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" /></head>
<body><nav class="navbar navbar-dark bg-primary"><div class="container"><a class="navbar-brand" asp-controller="Home" asp-action="Index">Administración de regiones</a></div></nav><main class="container py-4">
@if (TempData["Mensaje"] is not null) { <div class="alert alert-success">@TempData["Mensaje"]</div> }
@if (TempData["Error"] is not null) { <div class="alert alert-danger">@TempData["Error"]</div> }
@RenderBody()</main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>
